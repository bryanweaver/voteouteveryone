# ⚠️ WARNING: NEVER commit your .env.local file to git!
# This file should only contain placeholder values.
# Copy this to .env.local and fill in your actual API keys.

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Civic Information API
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable the Google Civic Information API for your project
# ⚠️ CRITICAL: Keep this key secret - do not commit to version control!
GOOGLE_CIVIC_API_KEY=your-google-civic-api-key-here
# Test Mode - Use Google's test election (2000) for development
# Set to "true" to enable test mode throughout the app
NEXT_PUBLIC_TEST_MODE=true

# OpenStates API (for state legislators)
# Get free API key from: https://openstates.org/accounts/profile/
# ⚠️ CRITICAL: Keep this key secret - do not commit to version control!
OPENSTATES_API_KEY=your-openstates-api-key-here

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3001


## OPTIONAL/FUTURE STUFF    

# OpenAI API (for future AI features)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# MailerSend (for email notifications)
# Get from: https://www.mailersend.com/
MAILERSEND_KEY=your-mailersend-key-here

# Physical Mailing Service (TODO: future postcard mailing)
LOB_API_KEY=your-lob-api-key-here
LOB_WEBHOOK_SECRET=your-lob-webhook-secret-here